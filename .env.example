# Copier ce fichier en .env puis adapter.
PORT=5000
# Développement local (docker compose up -d) :
MONGO_URI=mongodb://localhost:27017/isd
# Secret de signature des jetons : une longue chaîne aléatoire, différente en production.
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Chiffrement des messages bloqués du chat : 64 caractères hexadécimaux.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_ENCRYPTION_KEY=

# Numéro Mobile Money d'ISD (facture, Phase 5)
ISD_MOBILE_MONEY_NUMBER=

# Paiement automatique CinetPay (optionnel) : laissé vide = paiement Mobile Money vérifié manuellement.
# PUBLIC_API_URL : adresse publique HTTPS du serveur (CinetPay y envoie la confirmation).
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
PUBLIC_API_URL=
