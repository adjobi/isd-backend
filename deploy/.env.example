# Modèle de configuration. install.sh crée deploy/.env avec des secrets générés :
# ne remplissez à la main que si vous n'utilisez pas install.sh.
DOMAIN=isd-ci.com
ACME_EMAIL=contact@isd-ci.com
ISD_MOBILE_MONEY_NUMBER=+2250700000000
# Facultatif : numéro WhatsApp d'ISD affiché sur le site (bouton « Une question ? »), ex. 2250700000000
WHATSAPP_ISD=
# Facultatif : email de contact affiché dans l'app (« Aide et contact »)
CONTACT_EMAIL=
MONGO_PASSWORD=à-générer
JWT_SECRET=à-générer-128-caractères
# Ne JAMAIS changer après la mise en ligne : les messages bloqués du chat deviendraient illisibles.
CHAT_ENCRYPTION_KEY=à-générer-64-caractères-hexadécimaux
# Clé DISTINCTE pour les photos de vérification d'identité (openssl rand -hex 32).
# Les photos sont supprimées dès la décision (30 jours au plus) : la changer rend seulement illisibles
# les demandes en attente, qui sont alors rejetées automatiquement (à renvoyer).
IDENTITY_ENCRYPTION_KEY=à-générer-64-caractères-hexadécimaux
# Facultatif : paiement automatique CinetPay (entreprise enregistrée requise)
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
# Copie chiffrée des sauvegardes hors du serveur (voir README) : nom du stockage rclone, vide = désactivée
BACKUP_REMOTE=
BACKUP_PASSPHRASE=à-générer-64-caractères-hexadécimaux
