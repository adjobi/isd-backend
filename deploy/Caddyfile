# Serveur web : HTTPS automatique (Let's Encrypt). Sur le même domaine :
# le site vitrine (/), l'application web (/app/) et l'API (/api, /socket.io).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API et temps réel → serveur Node
	@api path /api/* /socket.io/*
	handle @api {
		reverse_proxy api:5000
	}

	# Application : fichiers versionnés (nom unique) mis en cache longtemps
	@app_static path /app/_expo/* /app/assets/*
	header @app_static Cache-Control "public, max-age=31536000, immutable"
	# Vitrine : styles et scripts (adresse versionnée par ?v=), images
	@site_static path /assets/*
	header @site_static Cache-Control "public, max-age=604800"

	redir /app /app/ 308

	# Application web (Expo) sous /app/ ; toute adresse de l'app renvoie l'application
	handle /app/* {
		root * /srv/site
		try_files {path} /app/index.html
		file_server
	}

	# Site vitrine (pages statiques) à la racine
	handle {
		root * /srv/site
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
