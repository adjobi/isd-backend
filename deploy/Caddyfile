# Serveur web : HTTPS automatique (Let's Encrypt). Sur le même domaine :
# le site vitrine (/), l'application web (/app/) et l'API (/api, /socket.io).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Politique de sécurité du contenu (CSP) : seuls les scripts du site lui-même s'exécutent.
	# Un script injecté (faille, extension malveillante, lien piégé) est bloqué par le navigateur.
	# Site vitrine : polices Google, aucune ligne de script en ligne.
	@site not path /app /app/* /api/* /socket.io/*
	header @site Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	# Application web : styles générés par React Native Web (en ligne), photos en data:/blob:,
	# temps réel par WebSocket sur le même domaine.
	@app path /app /app/*
	header @app Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' wss://{$DOMAIN} data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	# API : ne renvoie jamais de page à exécuter.
	@api_csp path /api/* /socket.io/*
	header @api_csp Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

	# API et temps réel → serveur Node
	@api path /api/* /socket.io/*
	handle @api {
		reverse_proxy api:5000
	}

	# Application : fichiers versionnés (nom unique) mis en cache longtemps
	@app_static path /app/_expo/* /app/assets/*
	header @app_static Cache-Control "public, max-age=31536000, immutable"
	# Vitrine : styles et scripts (adresse versionnée par ?v=), images
	@site_static path /assets/*
	header @site_static Cache-Control "public, max-age=604800"

	redir /app /app/ 308

	# Application web (Expo) sous /app/ ; toute adresse de l'app renvoie l'application
	handle /app/* {
		root * /srv/site
		try_files {path} /app/index.html
		file_server
	}

	# Site vitrine (pages statiques) à la racine
	handle {
		root * /srv/site
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
